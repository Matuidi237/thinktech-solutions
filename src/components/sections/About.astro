---
import type { Lang } from "../../i18n/utils";
import { useTranslations, highlightBrand } from "../../i18n/utils";

interface Props { lang: Lang }
const { lang } = Astro.props;
const t = useTranslations(lang);
---

<!-- Hero avec photo -->
<section class="about-hero" aria-label="Notre histoire">
  <img src="/images/about/team-photo.webp" alt={t.about.teamImageAlt} class="about-hero-bg" loading="eager" width="1440" height="600" />
  <div class="about-hero-overlay" aria-hidden="true"></div>
  <div class="container about-hero-inner">
    <p class="eyebrow about-hero-eyebrow">Notre histoire</p>
    <h1 id="about-title" class="about-hero-title">{t.about.title}</h1>
    <p class="about-hero-sub">{t.about.intro2}</p>
  </div>
</section>

<!-- Contenu principal : même layout que la homepage -->
<section id="about" class="about" aria-labelledby="about-content-title">
  <div class="circle-deco about-circle-1" aria-hidden="true"></div>
  <div class="circle-deco circle-delay circle-fill about-circle-2" aria-hidden="true"></div>
  <div class="container about-grid">

    <!-- Colonne gauche -->
    <div class="about-left reveal">
      <p set:html={highlightBrand(t.about.intro)} />
      <a href={`/${lang}/contact`} class="link-arrow">
        {lang === 'fr' ? 'Lancer un projet avec nous →' : 'Start a project with us →'}
      </a>

      <div class="moodle-badges">
        <p class="badges-label">
          {lang === 'fr' ? 'Certifiés Moodle Academy' : 'Moodle Academy certified'}
        </p>
        <div class="badges-row">
          <div class="badge-item">
            <img src="/images/badges/badge-moodle-dev.webp" alt="Moodle Development Environment" width="72" height="72" loading="lazy" />
            <span>Development<br/>Environment</span>
          </div>
          <div class="badge-item">
            <img src="/images/badges/badge-moodle-admin.webp" alt="Moodle Administration Settings" width="72" height="72" loading="lazy" />
            <span>Administration<br/>Settings</span>
          </div>
          <div class="badge-item">
            <img src="/images/badges/badge-moodle-teacher.webp" alt="Start Teaching with Moodle" width="72" height="72" loading="lazy" />
            <span>Start Teaching<br/>with Moodle</span>
          </div>
        </div>
      </div>
    </div>

    <!-- Colonne droite : valeurs -->
    <ul class="about-values reveal">
      {t.about.values.slice(0, 4).map((v: any) => (
        <li><strong>{v.title}</strong><span>{v.text}</span></li>
      ))}
    </ul>

  </div>

  <!-- Piliers mission / vision -->
  <div class="container">
    <div class="about-pillars">
      <article class="reveal"><span class="pillar-label">{t.about.mission.title}</span><p>{t.about.mission.text}</p></article>
      <article class="reveal"><span class="pillar-label">{t.about.visionMid.title}</span><p>{t.about.visionMid.text}</p></article>
      <article class="reveal"><span class="pillar-label">{t.about.visionLong.title}</span><p>{t.about.visionLong.text}</p></article>
    </div>

    <h3 class="values-title reveal">{t.about.valuesTitle}</h3>
    <ul class="values-grid">
      {t.about.values.map((v: any, i: number) => (
        <li class="value-item reveal">
          <span class="value-num">{String(i + 1).padStart(2, "0")}</span>
          <h4>{v.title}</h4>
          <p>{v.text}</p>
        </li>
      ))}
    </ul>
  </div>
</section>

<style>
  /* ── Hero ── */
  .about-hero {
    position: relative;
    min-height: 52vh;
    display: flex;
    align-items: center;
    overflow: hidden;
  }
  .about-hero-bg {
    position: absolute;
    inset: 0;
    width: 100%; height: 100%;
    object-fit: cover;
    object-position: center top;
    z-index: 0;
  }
  .about-hero-overlay {
    position: absolute;
    inset: 0;
    background: linear-gradient(90deg, rgba(2,33,121,0.88) 0%, rgba(2,33,121,0.65) 55%, rgba(2,33,121,0.25) 100%);
    z-index: 1;
  }
  .about-hero-inner {
    position: relative;
    z-index: 2;
    padding: 5rem 0 4rem;
    max-width: 680px;
  }
  .about-hero-eyebrow {
    color: rgba(255,255,255,0.7);
    font-size: 0.75rem;
    font-weight: 700;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    margin-bottom: 1rem;
  }
  .about-hero-title {
    color: #fff;
    font-size: clamp(2.2rem, 4.5vw, 3.5rem);
    line-height: 1.08;
    margin-bottom: 1.25rem;
  }
  .about-hero-sub {
    color: rgba(255,255,255,0.82);
    font-size: clamp(1rem, 1.4vw, 1.1rem);
    line-height: 1.75;
    font-style: italic;
    margin: 0;
    text-align: justify;
  }

  /* ── Section contenu ── */
  .about { position: relative; overflow: hidden; background: var(--color-bg-secondary); }
  .about-circle-1 { top: -60px; right: 8%; width: 200px; height: 200px; }
  .about-circle-2 { bottom: 10%; left: -70px; width: 260px; height: 260px; }

  .about-grid {
    position: relative; z-index: 1;
    display: grid;
    grid-template-columns: 1.3fr 1fr;
    gap: 3rem;
    align-items: start;
  }

  .about-left p { font-size: 1.05rem; line-height: 1.75; }

  .link-arrow {
    display: inline-block;
    margin-top: 1rem;
    font-weight: 600;
    color: var(--color-accent);
  }
  .link-arrow:hover { text-decoration: underline; }

  .moodle-badges { margin-top: 2rem; }
  .badges-label { font-size: 0.78rem; font-weight: 700; text-transform: uppercase; letter-spacing: 0.07em; color: var(--color-text-secondary); margin-bottom: 0.75rem; }
  .badges-row { display: flex; gap: 1.25rem; align-items: flex-start; flex-wrap: wrap; }
  .badge-item { display: flex; flex-direction: column; align-items: center; gap: 0.4rem; text-align: center; }
  .badge-item img { width: 72px; height: 72px; object-fit: contain; transition: transform 0.25s ease; }
  .badge-item img:hover { transform: scale(1.1); }
  .badge-item span { font-size: 0.7rem; color: var(--color-text-secondary); line-height: 1.3; }

  .about-values {
    list-style: none;
    display: flex;
    flex-direction: column;
    gap: 1.5rem;
    border-left: 2px solid var(--color-border);
    padding-left: 1.5rem;
  }
  .about-values strong { display: block; font-size: 1.05rem; margin-bottom: 0.25rem; }
  .about-values span { color: var(--color-text-secondary); font-size: 0.92rem; }

  /* ── Piliers & valeurs ── */
  .about-pillars { display: grid; grid-template-columns: repeat(3, 1fr); gap: 1rem; margin: 3.5rem 0 4rem; position: relative; z-index: 1; }
  .about-pillars article {
    padding: 1.75rem 1.5rem;
    border: 1px solid var(--color-border);
    border-radius: 10px;
    transition: transform 0.25s ease, box-shadow 0.25s ease, border-color 0.25s ease;
  }
  .about-pillars article:hover { transform: translateY(-6px); box-shadow: 0 18px 32px rgba(2,33,121,0.1); border-color: var(--color-accent); }
  .pillar-label { display: block; font-size: 1.1rem; margin-bottom: 0.5rem; color: var(--color-accent); }

  .values-title { margin-bottom: 1.5rem; position: relative; z-index: 1; }
  .values-grid { display: grid; grid-template-columns: repeat(4, 1fr); gap: 1rem; list-style: none; position: relative; z-index: 1; }
  .value-item {
    padding: 1.75rem 1.5rem;
    border: 1px solid var(--color-border);
    border-radius: 10px;
    transition: transform 0.25s ease, box-shadow 0.25s ease, border-color 0.25s ease;
  }
  .value-item:hover { transform: translateY(-6px); box-shadow: 0 18px 32px rgba(2,33,121,0.1); border-color: var(--color-accent); }
  .value-num { color: var(--color-text-secondary); font-size: 0.9rem; opacity: 0.6; }
  .value-item h4 { margin: 0.5rem 0 0.4rem; }

  @media (max-width: 900px) {
    .about-grid { grid-template-columns: 1fr; }
    .about-values { border-left: none; padding-left: 0; border-top: 2px solid var(--color-border); padding-top: 1.5rem; }
    .about-pillars, .values-grid { grid-template-columns: 1fr; }
  }
  @media (max-width: 640px) {
    .about-hero-inner { max-width: 100%; }
    .about-values { gap: 1rem; }
  }
</style>

<script is:inline src="/scripts/counter.js"></script>
