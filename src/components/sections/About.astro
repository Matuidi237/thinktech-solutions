---
import type { Lang } from "../../i18n/utils";
import { useTranslations, highlightBrand } from "../../i18n/utils";

interface Props { lang: Lang }
const { lang } = Astro.props;
const t = useTranslations(lang);

---

<!-- Section principale : layout image -->
<section id="about" class="about-main" aria-labelledby="about-main-title">
  <div class="circle-deco about-circle-1" aria-hidden="true"></div>
  <div class="circle-deco circle-fill circle-delay about-circle-2" aria-hidden="true"></div>
  <div class="about-main-grid">

    <!-- Gauche : texte + badges -->
    <div class="about-main-left">
      <p class="about-eyebrow-label anim-fade-up" style="--d:0s">{lang === 'fr' ? 'À propos' : 'About us'}</p>
      <h1 id="about-main-title" class="anim-fade-up" style="--d:0.08s">{t.about.title}</h1>
      <p class="about-main-desc anim-fade-up" style="--d:0.16s" set:html={highlightBrand(t.about.intro)} />

      <div class="moodle-badges anim-fade-up" style="--d:0.24s">
        <p class="badges-label">
          {lang === 'fr' ? 'Certifiés Moodle Academy' : 'Moodle Academy certified'}
        </p>
        <div class="badges-row">
          <div class="badge-item">
            <img src="/images/badges/badge-moodle-dev.webp" alt="Moodle Development Environment" width="64" height="64" loading="lazy" />
            <span>Development<br/>Environment</span>
          </div>
          <div class="badge-item">
            <img src="/images/badges/badge-moodle-admin.webp" alt="Moodle Administration Settings" width="64" height="64" loading="lazy" />
            <span>Administration<br/>Settings</span>
          </div>
          <div class="badge-item">
            <img src="/images/badges/badge-moodle-teacher.webp" alt="Start Teaching with Moodle" width="64" height="64" loading="lazy" />
            <span>Start Teaching<br/>with Moodle</span>
          </div>
        </div>
      </div>
    </div>

    <!-- Droite : photo bord à bord -->
    <div class="about-main-right">
      <img src="/images/about/001.webp" alt={t.about.teamImageAlt} class="about-main-photo" loading="lazy" width="700" height="520" />
    </div>

  </div>
</section>

<!-- Piliers mission / vision -->
<section class="about-pillars-section" aria-label="Mission et vision">
  <div class="container">
    <div class="about-pillars">
      <article class="reveal"><span class="pillar-label">{t.about.mission.title}</span><p>{t.about.mission.text}</p></article>
      <article class="reveal"><span class="pillar-label">{t.about.visionMid.title}</span><p>{t.about.visionMid.text}</p></article>
      <article class="reveal"><span class="pillar-label">{t.about.visionLong.title}</span><p>{t.about.visionLong.text}</p></article>
    </div>

    <h3 class="values-title reveal">{t.about.valuesTitle}</h3>
    <ul class="values-grid">
      {t.about.values.map((v: any, i: number) => (
        <li class="value-item reveal" style={`--vi:${i}`}>
          <span class="value-num">{String(i + 1).padStart(2, "0")}</span>
          <h4>{v.title}</h4>
          <p>{v.text}</p>
        </li>
      ))}
    </ul>
  </div>
</section>

<style>
  /* ── Animations ── */
  .anim-fade-up, .anim-fade-left {
    opacity: 0;
    transform: translateY(28px);
    transition: opacity 0.65s ease var(--d, 0s), transform 0.65s ease var(--d, 0s);
  }
  .anim-fade-left { transform: translateX(32px); }
  .about-main.in-view .anim-fade-up,
  .about-main.in-view .anim-fade-left {
    opacity: 1;
    transform: none;
  }

  /* ── Section principale ── */
  .about-main {
    background: var(--color-bg);
    padding: 4rem 0 5rem;
    overflow: hidden;
    position: relative;
  }
  .about-circle-1 { top: -80px; left: -60px; width: 320px; height: 320px; }
  .about-circle-2 { bottom: -60px; left: 30%; width: 200px; height: 200px; }
  .about-main-grid {
    display: grid;
    grid-template-columns: 1fr 1fr;
    align-items: center;
    position: relative;
    z-index: 1;
  }
  .about-main-left {
    padding-left: max(2rem, calc((100vw - 1200px) / 2 + 2rem));
    padding-right: 3.5rem;
  }

  .about-eyebrow-label {
    font-size: 0.75rem;
    font-weight: 700;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--color-text-secondary);
    margin-bottom: 0.75rem;
  }
  .about-main-left h1 {
    font-size: clamp(2rem, 3.5vw, 2.8rem);
    line-height: 1.15;
    margin-bottom: 1rem;
    color: var(--color-text-primary);
  }
  .about-main-desc {
    font-size: 1rem;
    line-height: 1.75;
    color: var(--color-text-secondary);
    margin-bottom: 2rem;
  }

  /* Badges Moodle */
  .moodle-badges { margin-bottom: 2rem; }
  .badges-label { font-size: 0.78rem; font-weight: 700; text-transform: uppercase; letter-spacing: 0.07em; color: var(--color-text-secondary); margin-bottom: 0.75rem; }
  .badges-row { display: flex; gap: 1.25rem; align-items: flex-start; flex-wrap: wrap; }
  .badge-item { display: flex; flex-direction: column; align-items: center; gap: 0.4rem; text-align: center; }
  .badge-item img { width: 64px; height: 64px; object-fit: contain; transition: transform 0.25s ease; }
  .badge-item img:hover { transform: scale(1.1); }
  .badge-item span { font-size: 0.68rem; color: var(--color-text-secondary); line-height: 1.3; }

  /* Photo droite */
  .about-main-right {
    height: 600px;
    overflow: hidden;
    border-radius: 16px;
    padding-right: 1.5rem;
  }
  .about-main-photo {
    width: 100%;
    height: 115%;
    object-fit: cover;
    border-radius: 16px;
    display: block;
    opacity: 0;
    transform: scale(1.12) translateY(-4%);
    will-change: transform, opacity;
    transition: opacity 0.9s ease 0.1s;
  }
  .about-main.in-view .about-main-photo {
    opacity: 1;
  }

  /* ── Piliers & valeurs ── */
  .about-pillars-section {
    background: var(--color-bg-secondary);
    padding: 4rem 0 5rem;
    position: relative;
    overflow: hidden;
  }
  .about-pillars { display: grid; grid-template-columns: repeat(3, 1fr); gap: 1rem; margin-bottom: 4rem; }
  .about-pillars article {
    padding: 1.75rem 1.5rem;
    border: 1px solid var(--color-border);
    border-radius: 10px;
    transition: transform 0.25s ease, box-shadow 0.25s ease, border-color 0.25s ease;
  }
  .about-pillars article:hover { transform: translateY(-6px); box-shadow: 0 18px 32px rgba(2,33,121,0.1); border-color: var(--color-accent); }
  .pillar-label { display: block; font-size: 1.1rem; margin-bottom: 0.5rem; color: var(--color-accent); font-weight: 700; }

  .values-title { margin-bottom: 1.5rem; }
  .values-grid { display: grid; grid-template-columns: repeat(4, 1fr); gap: 1rem; list-style: none; }
  .value-item {
    padding: 1.75rem 1.5rem;
    border: 1px solid var(--color-border);
    border-radius: 10px;
    transition: transform 0.25s ease, box-shadow 0.25s ease, border-color 0.25s ease;
  }
  .value-item:hover { transform: translateY(-6px); box-shadow: 0 18px 32px rgba(2,33,121,0.1); border-color: var(--color-accent); }
  .value-num { color: var(--color-text-secondary); font-size: 0.9rem; opacity: 0.6; }
  .value-item h4 { margin: 0.5rem 0 0.4rem; }

  @media (max-width: 900px) {
    .about-main-grid { grid-template-columns: 1fr; }
    .about-main-left { padding-left: 1.5rem; padding-right: 1.5rem; }
    .about-main-right { order: -1; height: 300px; }
    .about-main-photo { border-radius: 0; }
    .about-pillars, .values-grid { grid-template-columns: 1fr; }
  }
</style>

<script is:inline>
(function () {
  var section = document.querySelector('.about-main');
  var photo   = section && section.querySelector('.about-main-photo');
  if (!section || !photo) return;

  /* Entry fade */
  var io = new IntersectionObserver(function(entries) {
    entries.forEach(function(e) {
      if (e.isIntersecting) { section.classList.add('in-view'); io.disconnect(); }
    });
  }, { threshold: 0.12 });
  io.observe(section);

  /* Scroll-Driven Zoom — JS universel */
  var ticking = false;
  function updateZoom() {
    var rect = section.getBoundingClientRect();
    var total = window.innerHeight + rect.height;
    var progress = Math.max(0, Math.min(1, (window.innerHeight - rect.top) / total));
    var scale = 1.12 - progress * 0.12;
    var ty = -4 + progress * 4;
    photo.style.transform = 'scale(' + scale + ') translateY(' + ty + '%)';
    ticking = false;
  }
  window.addEventListener('scroll', function() {
    if (!ticking) { requestAnimationFrame(updateZoom); ticking = true; }
  }, { passive: true });
  updateZoom();

  /* reveal for pillars/values */
  var reveals = document.querySelectorAll('.reveal');
  if (!reveals.length) return;
  var ro = new IntersectionObserver(function(entries) {
    entries.forEach(function(e) {
      if (e.isIntersecting) {
        var el = e.target;
        var vi = el.style.getPropertyValue('--vi') || '0';
        el.style.transitionDelay = (parseFloat(vi) * 0.08) + 's';
        el.classList.add('is-visible');
        ro.unobserve(el);
      }
    });
  }, { threshold: 0.15 });
  reveals.forEach(function(el) { ro.observe(el); });
})();
</script>
