---
import type { Lang } from "../../i18n/utils";
import { useTranslations, highlightBrand } from "../../i18n/utils";

interface Props { lang: Lang }
const { lang } = Astro.props;
const t = useTranslations(lang);
---

<section id="about" class="about-main" aria-labelledby="about-main-title">
  <div class="circle-deco about-circle-1" aria-hidden="true"></div>
  <div class="circle-deco circle-fill circle-delay about-circle-2" aria-hidden="true"></div>

  <div class="about-main-grid">

    <!-- Gauche -->
    <div class="about-main-left">
      <p class="about-eyebrow anim-up" style="--d:0s">
        <span class="eyebrow-dot" aria-hidden="true"></span>
        {lang === 'fr' ? 'À propos de nous' : 'About us'}
      </p>

      <h1 id="about-main-title" class="anim-up" style="--d:0.08s">{t.about.title}</h1>

      <p class="about-desc anim-up" style="--d:0.16s" set:html={highlightBrand(t.about.intro)} />

      <div class="about-sep anim-up" style="--d:0.22s" aria-hidden="true"></div>

      <div class="moodle-card anim-up" style="--d:0.28s">
        <p class="badges-label">
          {lang === 'fr' ? 'Certifiés Moodle Academy' : 'Moodle Academy certified'}
        </p>
        <div class="badges-row">
          <div class="badge-item">
            <img src="/images/badges/badge-moodle-dev.webp" alt="Moodle Development Environment" width="64" height="64" loading="lazy" />
            <span>Development<br/>Environment</span>
          </div>
          <div class="badge-item">
            <img src="/images/badges/badge-moodle-admin.webp" alt="Moodle Administration Settings" width="64" height="64" loading="lazy" />
            <span>Administration<br/>Settings</span>
          </div>
          <div class="badge-item">
            <img src="/images/badges/badge-moodle-teacher.webp" alt="Start Teaching with Moodle" width="64" height="64" loading="lazy" />
            <span>Start Teaching<br/>with Moodle</span>
          </div>
        </div>
      </div>

      <a href={`/${lang}/contact`} class="about-cta anim-up" style="--d:0.36s">
        {lang === 'fr' ? 'Lancer un projet avec nous' : 'Start a project with us'}
        <span aria-hidden="true">→</span>
      </a>
    </div>

    <!-- Droite : photo + décoration -->
    <div class="about-main-right">
      <div class="photo-frame" aria-hidden="true"></div>
      <img
        src="/images/about/001.webp"
        alt={t.about.teamImageAlt}
        class="about-photo"
        loading="lazy"
        width="700" height="520"
      />
    </div>

  </div>
</section>

<!-- Piliers mission / vision -->
<section class="about-pillars-section" aria-label="Mission et vision">
  <div class="container">
    <div class="about-pillars">
      <article class="reveal"><span class="pillar-label">{t.about.mission.title}</span><p>{t.about.mission.text}</p></article>
      <article class="reveal"><span class="pillar-label">{t.about.visionMid.title}</span><p>{t.about.visionMid.text}</p></article>
      <article class="reveal"><span class="pillar-label">{t.about.visionLong.title}</span><p>{t.about.visionLong.text}</p></article>
    </div>

    <h3 class="values-title reveal">{t.about.valuesTitle}</h3>
    <ul class="values-grid">
      {t.about.values.map((v: any, i: number) => (
        <li class="value-item reveal" style={`--vi:${i}`}>
          <span class="value-num">{String(i + 1).padStart(2, "0")}</span>
          <h4>{v.title}</h4>
          <p>{v.text}</p>
        </li>
      ))}
    </ul>
  </div>
</section>

<style>
  /* ── Animations d'entrée ── */
  .anim-up {
    opacity: 0;
    transform: translateY(24px);
    transition: opacity 0.6s ease var(--d, 0s), transform 0.6s ease var(--d, 0s);
  }
  .about-main.in-view .anim-up { opacity: 1; transform: none; }

  .about-photo {
    opacity: 0;
    transform: scale(1.12);
    transition: opacity 0.8s ease 0.2s, transform 0.9s cubic-bezier(0.22, 1, 0.36, 1) 0.2s;
  }
  .about-main.in-view .about-photo { opacity: 1; transform: scale(1); }

  /* ── Section ── */
  .about-main {
    background: var(--color-bg);
    padding: 4rem 0 5rem;
    overflow: hidden;
    position: relative;
  }
  .about-circle-1 { top: -80px; left: -60px; width: 320px; height: 320px; }
  .about-circle-2 { bottom: -60px; left: 30%; width: 200px; height: 200px; }

  .about-main-grid {
    display: grid;
    grid-template-columns: 1fr 1fr;
    align-items: center;
    position: relative;
    z-index: 1;
  }
  .about-main-left {
    padding-left: max(2rem, calc((100vw - 1200px) / 2 + 2rem));
    padding-right: 3.5rem;
    padding-top: 2rem;
    padding-bottom: 2rem;
  }

  /* Eyebrow */
  .about-eyebrow {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    font-size: 0.72rem;
    font-weight: 700;
    letter-spacing: 0.13em;
    text-transform: uppercase;
    color: var(--color-primary);
    margin-bottom: 1rem;
  }
  .eyebrow-dot {
    width: 8px; height: 8px;
    border-radius: 50%;
    background: var(--color-accent);
    flex-shrink: 0;
  }

  /* Titre */
  .about-main-left h1 {
    font-size: clamp(2rem, 3.5vw, 2.8rem);
    line-height: 1.12;
    margin-bottom: 1.25rem;
    color: var(--color-text-primary);
  }

  /* Description */
  .about-desc {
    font-size: 0.97rem;
    line-height: 1.8;
    color: var(--color-text-secondary);
    margin-bottom: 1.75rem;
  }

  /* Séparateur */
  .about-sep {
    width: 48px; height: 3px;
    background: linear-gradient(90deg, var(--color-primary), var(--color-accent));
    border-radius: 2px;
    margin-bottom: 1.75rem;
  }

  /* Carte badges */
  .moodle-card {
    background: var(--color-bg-secondary);
    border: 1px solid var(--color-border);
    border-radius: 12px;
    padding: 1.25rem 1.5rem;
    margin-bottom: 1.75rem;
  }
  .badges-label {
    font-size: 0.72rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.08em;
    color: var(--color-text-secondary);
    margin-bottom: 1rem;
  }
  .badges-row { display: flex; gap: 1.5rem; align-items: flex-start; flex-wrap: wrap; }
  .badge-item { display: flex; flex-direction: column; align-items: center; gap: 0.4rem; text-align: center; }
  .badge-item img { width: 60px; height: 60px; object-fit: contain; transition: transform 0.25s ease; }
  .badge-item img:hover { transform: scale(1.1); }
  .badge-item span { font-size: 0.65rem; color: var(--color-text-secondary); line-height: 1.3; }

  /* CTA */
  .about-cta {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    font-size: 0.9rem;
    font-weight: 700;
    color: var(--color-primary);
    border-bottom: 2px solid transparent;
    padding-bottom: 2px;
    transition: border-color 0.2s ease, gap 0.2s ease;
  }
  .about-cta:hover { border-color: var(--color-accent); gap: 0.75rem; }

  /* Photo droite */
  .about-main-right {
    position: relative;
    height: 580px;
    padding: 1.5rem 0 1.5rem 1.5rem;
  }
  .photo-frame {
    position: absolute;
    top: 0; right: -2rem; bottom: 0; left: 3rem;
    background: linear-gradient(135deg, var(--color-primary) 0%, #1a4fd8 100%);
    opacity: 0.07;
    border-radius: 20px;
  }
  .about-photo {
    width: 100%;
    height: 100%;
    object-fit: cover;
    border-radius: 16px;
    display: block;
    box-shadow: 0 24px 60px rgba(2, 33, 121, 0.18);
  }

  /* ── Section piliers & valeurs ── */
  .about-pillars-section {
    background: var(--color-bg-secondary);
    padding: 4rem 0 5rem;
    position: relative;
    overflow: hidden;
  }
  .about-pillars { display: grid; grid-template-columns: repeat(3, 1fr); gap: 1rem; margin-bottom: 4rem; }
  .about-pillars article {
    padding: 1.75rem 1.5rem;
    border: 1px solid var(--color-border);
    border-radius: 10px;
    transition: transform 0.25s ease, box-shadow 0.25s ease, border-color 0.25s ease;
  }
  .about-pillars article:hover { transform: translateY(-6px); box-shadow: 0 18px 32px rgba(2,33,121,0.1); border-color: var(--color-accent); }
  .pillar-label { display: block; font-size: 1.05rem; font-weight: 700; margin-bottom: 0.5rem; color: var(--color-accent); }

  .values-title { margin-bottom: 1.5rem; }
  .values-grid { display: grid; grid-template-columns: repeat(4, 1fr); gap: 1rem; list-style: none; }
  .value-item {
    padding: 1.75rem 1.5rem;
    border: 1px solid var(--color-border);
    border-radius: 10px;
    transition: transform 0.25s ease, box-shadow 0.25s ease, border-color 0.25s ease;
  }
  .value-item:hover { transform: translateY(-6px); box-shadow: 0 18px 32px rgba(2,33,121,0.1); border-color: var(--color-accent); }
  .value-num { color: var(--color-text-secondary); font-size: 0.9rem; opacity: 0.6; }
  .value-item h4 { margin: 0.5rem 0 0.4rem; }

  @media (max-width: 900px) {
    .about-eyebrow { display: none; }
    .about-main { padding: 3rem 0 4rem; }
    .about-main-grid { grid-template-columns: 1fr; gap: 0; }
    .about-main-left {
      padding: 0 1.25rem 2rem;
      order: 2;
    }
    .about-main-right {
      order: 1;
      height: 260px;
      padding: 0 1.25rem 2rem;
    }
    .photo-frame { display: none; }
    .about-photo {
      border-radius: 12px;
      box-shadow: 0 12px 32px rgba(2,33,121,0.14);
      height: 260px;
    }
    .about-pillars { grid-template-columns: 1fr; }
    .values-grid { grid-template-columns: 1fr 1fr; }
  }
  @media (max-width: 480px) {
    .about-main-right { height: 220px; padding: 0 1rem 1.5rem; }
    .about-photo { height: 220px; }
    .about-main-left { padding: 0 1rem 2rem; }
    .badges-row { gap: 1rem; }
    .values-grid { grid-template-columns: 1fr; }
  }
</style>

<script is:inline>
(function () {
  var section = document.querySelector('.about-main');
  if (!section) return;

  /* Animation photo + texte : attend un vrai scroll si la section
     est déjà visible au chargement (pas de hero au-dessus) */
  function startMainObserver() {
    var io = new IntersectionObserver(function(entries) {
      entries.forEach(function(e) {
        if (e.isIntersecting) { section.classList.add('in-view'); io.disconnect(); }
      });
    }, { threshold: 0.18, rootMargin: '0px 0px -80px 0px' });
    io.observe(section);
  }

  var rect = section.getBoundingClientRect();
  var alreadyVisible = rect.top < window.innerHeight * 0.5 && window.scrollY < 10;

  if (alreadyVisible) {
    /* Attendre que l'utilisateur scroll un peu */
    var waited = false;
    window.addEventListener('scroll', function onFirstScroll() {
      if (waited) return;
      waited = true;
      window.removeEventListener('scroll', onFirstScroll);
      startMainObserver();
    }, { passive: true });
  } else {
    startMainObserver();
  }

  /* Piliers & valeurs */
  var reveals = document.querySelectorAll('.reveal');
  if (!reveals.length) return;
  var ro = new IntersectionObserver(function(entries) {
    entries.forEach(function(e) {
      if (e.isIntersecting) {
        var el = e.target;
        var vi = el.style.getPropertyValue('--vi') || '0';
        el.style.transitionDelay = (parseFloat(vi) * 0.08) + 's';
        el.classList.add('is-visible');
        ro.unobserve(el);
      }
    });
  }, { threshold: 0.15 });
  reveals.forEach(function(el) { ro.observe(el); });
})();
</script>
