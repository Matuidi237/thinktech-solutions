---
import type { Lang } from "../../i18n/utils";
import { useTranslations, highlightBrand } from "../../i18n/utils";

interface Props { lang: Lang }
const { lang } = Astro.props;
const t = useTranslations(lang);

const metrics = lang === 'fr'
  ? [
      { value: "+10", label: "experts dédiés à vos projets" },
      { value: "+20", label: "plateformes e-learning déployées" },
      { value: "3",   label: "pays couverts en Afrique centrale" },
      { value: "24/7", label: "support technique disponible" },
    ]
  : [
      { value: "+10",  label: "experts dedicated to your projects" },
      { value: "+20",  label: "e-learning platforms deployed" },
      { value: "3",    label: "countries covered in Central Africa" },
      { value: "24/7", label: "technical support available" },
    ];
---

<!-- Hero plein écran -->
<section class="about-hero" aria-label="Notre histoire">
  <img src="/images/about/001.webp" alt={t.about.teamImageAlt} class="about-hero-bg" loading="eager" width="1500" height="1001" />
  <div class="about-hero-overlay" aria-hidden="true"></div>
  <div class="container about-hero-inner">
    <p class="eyebrow about-hero-eyebrow">{lang === 'fr' ? 'Notre histoire' : 'Our story'}</p>
    <h1 id="about-title" class="about-hero-title">{t.about.title}</h1>
    <p class="about-hero-sub" set:html={t.about.intro2} />
  </div>
</section>

<!-- Section principale : layout image -->
<section id="about" class="about-main" aria-labelledby="about-main-title">
  <div class="container about-main-grid">

    <!-- Gauche : texte + métriques -->
    <div class="about-main-left reveal">
      <p class="about-eyebrow-label">{lang === 'fr' ? 'À propos' : 'About us'}</p>
      <h2 id="about-main-title" set:html={highlightBrand(t.about.intro)} />

      <div class="about-metrics">
        {metrics.map(m => (
          <div class="about-metric">
            <span class="metric-value" data-target={m.value}>{m.value}</span>
            <span class="metric-label">{m.label}</span>
          </div>
        ))}
      </div>

      <div class="moodle-badges">
        <p class="badges-label">
          {lang === 'fr' ? 'Certifiés Moodle Academy' : 'Moodle Academy certified'}
        </p>
        <div class="badges-row">
          <div class="badge-item">
            <img src="/images/badges/badge-moodle-dev.webp" alt="Moodle Development Environment" width="64" height="64" loading="lazy" />
            <span>Development<br/>Environment</span>
          </div>
          <div class="badge-item">
            <img src="/images/badges/badge-moodle-admin.webp" alt="Moodle Administration Settings" width="64" height="64" loading="lazy" />
            <span>Administration<br/>Settings</span>
          </div>
          <div class="badge-item">
            <img src="/images/badges/badge-moodle-teacher.webp" alt="Start Teaching with Moodle" width="64" height="64" loading="lazy" />
            <span>Start Teaching<br/>with Moodle</span>
          </div>
        </div>
      </div>
    </div>

    <!-- Droite : photo -->
    <div class="about-main-right reveal">
      <img src="/images/about/001.webp" alt={t.about.teamImageAlt} class="about-main-photo" loading="lazy" width="700" height="520" />
    </div>

  </div>
</section>

<!-- Piliers mission / vision -->
<section class="about-pillars-section" aria-label="Mission et vision">
  <div class="container">
    <div class="about-pillars">
      <article class="reveal"><span class="pillar-label">{t.about.mission.title}</span><p>{t.about.mission.text}</p></article>
      <article class="reveal"><span class="pillar-label">{t.about.visionMid.title}</span><p>{t.about.visionMid.text}</p></article>
      <article class="reveal"><span class="pillar-label">{t.about.visionLong.title}</span><p>{t.about.visionLong.text}</p></article>
    </div>

    <h3 class="values-title reveal">{t.about.valuesTitle}</h3>
    <ul class="values-grid">
      {t.about.values.map((v: any, i: number) => (
        <li class="value-item reveal">
          <span class="value-num">{String(i + 1).padStart(2, "0")}</span>
          <h4>{v.title}</h4>
          <p>{v.text}</p>
        </li>
      ))}
    </ul>
  </div>
</section>

<style>
  /* ── Hero plein écran ── */
  .about-hero {
    position: relative;
    min-height: 58vh;
    display: flex;
    align-items: center;
    overflow: hidden;
  }
  .about-hero-bg {
    position: absolute;
    inset: 0;
    width: 100%; height: 100%;
    object-fit: cover;
    object-position: center center;
    z-index: 0;
  }
  .about-hero-overlay {
    position: absolute;
    inset: 0;
    background: linear-gradient(90deg, rgba(2,33,121,0.92) 0%, rgba(2,33,121,0.72) 50%, rgba(2,33,121,0.20) 100%);
    z-index: 1;
  }
  .about-hero-inner {
    position: relative;
    z-index: 2;
    padding: 5rem 0 4rem;
    max-width: 64%;
    width: 100%;
  }
  .about-hero-eyebrow {
    color: rgba(255,255,255,0.7);
    font-size: 0.75rem;
    font-weight: 700;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    margin-bottom: 1rem;
  }
  .about-hero-title {
    color: #fff;
    font-size: clamp(2.2rem, 4.5vw, 3.5rem);
    line-height: 1.08;
    margin-bottom: 1.25rem;
  }
  .about-hero-sub {
    color: rgba(255,255,255,0.82);
    font-size: clamp(1rem, 1.4vw, 1.1rem);
    line-height: 1.75;
    font-style: italic;
    margin: 0;
    text-align: justify;
  }

  /* ── Section principale ── */
  .about-main {
    background: var(--color-bg);
    padding: 5rem 0;
  }
  .about-main-grid {
    display: grid;
    grid-template-columns: 1.1fr 1fr;
    gap: 4rem;
    align-items: center;
  }

  .about-eyebrow-label {
    font-size: 0.75rem;
    font-weight: 700;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--color-text-secondary);
    margin-bottom: 0.75rem;
  }
  .about-main-left h2 {
    font-size: clamp(1.5rem, 2.5vw, 2rem);
    line-height: 1.35;
    margin-bottom: 2rem;
    color: var(--color-text-primary);
  }

  /* Grille métriques 2×2 */
  .about-metrics {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 1.25rem 2rem;
    margin-bottom: 2.5rem;
  }
  .about-metric {
    border-top: 3px solid var(--color-primary);
    padding-top: 0.75rem;
  }
  .metric-value {
    display: block;
    font-size: 1.9rem;
    font-weight: 800;
    color: var(--color-primary);
    line-height: 1.1;
    margin-bottom: 0.3rem;
  }
  .metric-label {
    font-size: 0.85rem;
    color: var(--color-text-secondary);
    line-height: 1.4;
  }

  /* Badges Moodle */
  .moodle-badges { margin-top: 0.5rem; }
  .badges-label { font-size: 0.78rem; font-weight: 700; text-transform: uppercase; letter-spacing: 0.07em; color: var(--color-text-secondary); margin-bottom: 0.75rem; }
  .badges-row { display: flex; gap: 1.25rem; align-items: flex-start; flex-wrap: wrap; }
  .badge-item { display: flex; flex-direction: column; align-items: center; gap: 0.4rem; text-align: center; }
  .badge-item img { width: 64px; height: 64px; object-fit: contain; transition: transform 0.25s ease; }
  .badge-item img:hover { transform: scale(1.1); }
  .badge-item span { font-size: 0.68rem; color: var(--color-text-secondary); line-height: 1.3; }

  /* Photo droite */
  .about-main-photo {
    width: 100%;
    height: 480px;
    object-fit: cover;
    border-radius: 16px;
    display: block;
  }

  /* ── Piliers & valeurs ── */
  .about-pillars-section {
    background: var(--color-bg-secondary);
    padding: 4rem 0 5rem;
    position: relative;
    overflow: hidden;
  }
  .about-pillars { display: grid; grid-template-columns: repeat(3, 1fr); gap: 1rem; margin-bottom: 4rem; }
  .about-pillars article {
    padding: 1.75rem 1.5rem;
    border: 1px solid var(--color-border);
    border-radius: 10px;
    transition: transform 0.25s ease, box-shadow 0.25s ease, border-color 0.25s ease;
  }
  .about-pillars article:hover { transform: translateY(-6px); box-shadow: 0 18px 32px rgba(2,33,121,0.1); border-color: var(--color-accent); }
  .pillar-label { display: block; font-size: 1.1rem; margin-bottom: 0.5rem; color: var(--color-accent); font-weight: 700; }

  .values-title { margin-bottom: 1.5rem; }
  .values-grid { display: grid; grid-template-columns: repeat(4, 1fr); gap: 1rem; list-style: none; }
  .value-item {
    padding: 1.75rem 1.5rem;
    border: 1px solid var(--color-border);
    border-radius: 10px;
    transition: transform 0.25s ease, box-shadow 0.25s ease, border-color 0.25s ease;
  }
  .value-item:hover { transform: translateY(-6px); box-shadow: 0 18px 32px rgba(2,33,121,0.1); border-color: var(--color-accent); }
  .value-num { color: var(--color-text-secondary); font-size: 0.9rem; opacity: 0.6; }
  .value-item h4 { margin: 0.5rem 0 0.4rem; }

  @media (max-width: 900px) {
    .about-main-grid { grid-template-columns: 1fr; gap: 2.5rem; }
    .about-main-right { order: -1; }
    .about-main-photo { height: 280px; }
    .about-pillars, .values-grid { grid-template-columns: 1fr; }
  }
  @media (max-width: 640px) {
    .about-hero-inner { max-width: 100%; }
    .about-metrics { grid-template-columns: 1fr 1fr; gap: 1rem; }
  }
</style>
