---
import BaseLayout from "../../layouts/BaseLayout.astro";
import Header from "../../components/layout/Header.astro";
import Footer from "../../components/layout/Footer.astro";
import Hero from "../../components/sections/Hero.astro";
import ChatbotWidget from "../../components/chatbot/ChatbotWidget.astro";
import { useTranslations } from "../../i18n/utils";

const lang = "en";
const t = useTranslations(lang);
---

<BaseLayout
  lang={lang}
  title="ThinkTech Solutions Moodle platforms for training in Africa"
  description="Moodle expert in Cameroon. ThinkTech Solutions designs and deploys secure e-learning platforms for universities, companies and NGOs in Douala and across Central Africa."
>
  <Header lang={lang} />
  <main id="main-content">
    <Hero lang={lang} />

    <section class="home-why" aria-labelledby="home-why-title">
      <div class="container">
        <p class="eyebrow">Training &amp; Transformation</p>
        <h2 id="home-why-title" class="reveal">Why digitalise your training in 2026?</h2>
        <p class="why-intro reveal">Across Africa and beyond, organisations that still rely solely on in-person training pay a steep price. E-learning is no longer a luxury — it is a strategic necessity.</p>

        <div class="why-split">

          <div class="why-col why-col-before">
            <span class="why-col-label">Without digital</span>
            <div class="why-items">
              <div class="why-item why-item-before"><p>One absent teacher brings an entire cohort to a halt.</p></div>
              <div class="why-item why-item-before"><p>Your classrooms set a hard ceiling on how many learners you can train.</p></div>
              <div class="why-item why-item-before"><p>Teaching materials disappear at the end of every semester.</p></div>
              <div class="why-item why-item-before"><p>Zero visibility into who is actually learning — and who is falling behind.</p></div>
            </div>
          </div>

          <div class="why-divider" aria-hidden="true">
            <div class="why-divider-line"></div>
            <span class="why-divider-arrow">→</span>
            <div class="why-divider-line"></div>
          </div>

          <div class="why-col why-col-after">
            <span class="why-col-label">With ThinkTech</span>
            <div class="why-items">
              <div class="why-item why-item-after"><p>The course stays available 24/7, even when the teacher cannot be there.</p></div>
              <div class="why-item why-item-after"><p>Train far more learners with no classroom constraints.</p></div>
              <div class="why-item why-item-after"><p>Every piece of content you produce, reusable year after year.</p></div>
              <div class="why-item why-item-after"><p>Real-time dashboards for every trainer and every learner.</p></div>
            </div>
          </div>

        </div>

        <div class="why-footer">
          <div class="why-footer-stat">
            <strong class="why-stat-num">100%</strong>
            <span class="why-stat-text">of fixed in-person costs repeat with every new session</span>
          </div>
          <a href={`/${lang}/contact`} class="why-footer-cta">Start my project</a>
        </div>

      </div>
    </section>

    <section class="home-services" aria-labelledby="home-services-title">
      <div class="circle-deco home-services-circle-1" aria-hidden="true"></div>
      <div class="circle-deco circle-fill circle-delay home-services-circle-2" aria-hidden="true"></div>
      <div class="container home-services-inner">
        <div class="home-services-text">
          <p class="eyebrow">Our expertise</p>
          <h2 id="home-services-title">{t.services.title}</h2>
          <ol class="home-services-list">
            {t.services.cards.map((c: any, i: number) => (
              <li>
                <span class="num">{String(i + 1).padStart(2, "0")}</span>
                <div>
                  <h3>{c.title}</h3>
                  <p>{c.benefit}</p>
                </div>
              </li>
            ))}
          </ol>
          <a href={`/${lang}/services`} class="link-arrow">See all our services →</a>
        </div>
        <div class="tools-orbit" aria-hidden="true">
          <span class="orbit-hub"></span>
          <div class="orbit-ring orbit-ring-1">
            <span class="orbit-icon orbit-icon-counter-1">
              <svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M14.7 6.3a1 1 0 0 0 0 1.4l1.6 1.6a1 1 0 0 0 1.4 0l3.77-3.77a6 6 0 0 1-7.94 7.94l-6.91 6.91a2.12 2.12 0 0 1-3-3l6.91-6.91a6 6 0 0 1 7.94-7.94l-3.76 3.76z"/></svg>
            </span>
          </div>
          <div class="orbit-ring orbit-ring-2">
            <span class="orbit-icon orbit-icon-counter-2">
              <svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="2" y="2" width="20" height="8" rx="2"/><rect x="2" y="14" width="20" height="8" rx="2"/><path d="M6 6h.01M6 18h.01"/></svg>
            </span>
          </div>
          <div class="orbit-ring orbit-ring-3">
            <span class="orbit-icon orbit-icon-counter-3">
              <svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"/></svg>
            </span>
          </div>
          <div class="orbit-ring orbit-ring-4">
            <span class="orbit-icon orbit-icon-counter-4">
              <svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M22 10 12 5 2 10l10 5 10-5z"/><path d="M6 12v5c0 1.5 3 3 6 3s6-1.5 6-3v-5"/></svg>
            </span>
          </div>
          <div class="orbit-ring orbit-ring-5">
            <span class="orbit-icon orbit-icon-counter-5">
              <svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M9 2v6M15 2v6M5 8h14l-1 5a6 6 0 0 1-12 0L5 8z"/><path d="M12 19v3"/></svg>
            </span>
          </div>
        </div>
      </div>
    </section>

    <section class="home-cta" aria-labelledby="home-cta-title">
      <div class="home-cta-img" aria-hidden="true"></div>
      <div class="home-cta-overlay" aria-hidden="true"></div>
      <div class="container">
        <div class="home-cta-inner reveal">
          <p class="home-cta-eyebrow">{t.contact.eyebrow ?? "Let's work together"}</p>
          <h2 id="home-cta-title" class="home-cta-title">{t.contact.title}</h2>
          <p class="home-cta-sub">{t.contact.subtitle}</p>
          <a href={`/${lang}/contact`} class="btn-hero">
            {t.hero.ctaPrimary}
            <svg viewBox="0 0 20 20" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" width="18" height="18"><path d="M4 10h12M11 5l5 5-5 5"/></svg>
          </a>
        </div>
      </div>
    </section>
  </main>
  <Footer lang={lang} />
  <ChatbotWidget lang={lang} />
</BaseLayout>

<style>
  /* ── Why digitalise section ── */
  .home-why { background: var(--color-bg-secondary); }
  .why-intro {
    max-width: 640px; color: var(--color-text-secondary);
    font-size: 1.05rem; margin: 0.5rem 0 2.75rem; line-height: 1.78;
  }

  /* Grid desktop : before | divider | after */
  .why-split {
    display: grid;
    grid-template-columns: 1fr 48px 1fr;
    margin-bottom: 2.25rem;
    align-items: start;
  }

  /* Column label */
  .why-col-label {
    display: inline-flex; align-items: center; gap: 0.45rem;
    font-size: 0.67rem; font-weight: 700; letter-spacing: 0.13em;
    text-transform: uppercase; margin-bottom: 1.25rem;
    opacity: 0; transform: translateY(8px);
    transition: opacity 0.4s ease, transform 0.4s ease;
  }
  .why-col-label.is-visible { opacity: 1; transform: translateY(0); }
  .why-col-label::before {
    content: ''; display: inline-block; width: 6px; height: 6px; border-radius: 50%;
    flex-shrink: 0;
  }
  .why-col-before .why-col-label { color: var(--color-text-secondary); }
  .why-col-before .why-col-label::before { background: var(--color-border); }
  .why-col-after  .why-col-label { color: var(--color-accent); }
  .why-col-after  .why-col-label::before { background: var(--color-accent); }

  /* Items list */
  .why-items { display: flex; flex-direction: column; gap: 1rem; }

  .why-item {
    padding: 0.6rem 0.9rem;
    border-radius: 0 8px 8px 0;
    opacity: 0;
    transition: background 0.22s ease, border-color 0.22s ease;
  }
  .why-item-before {
    border-left: 2px solid var(--color-border);
    transform: translateX(-36px);
    transition: opacity 0.55s ease, transform 0.65s cubic-bezier(0.22,1,0.36,1),
                background 0.22s ease, border-color 0.22s ease;
  }
  .why-item-after {
    border-left: 2px solid var(--color-accent);
    transform: translateX(36px);
    transition: opacity 0.55s ease, transform 0.65s cubic-bezier(0.22,1,0.36,1),
                background 0.22s ease, border-color 0.22s ease;
  }
  .why-item.is-visible { opacity: 1; transform: translateX(0); }

  .why-item-before:hover { background: var(--color-bg); }
  .why-item-after:hover  { background: rgba(2,33,121,0.04); border-color: var(--color-primary); }

  .why-item p { font-size: 0.93rem; margin: 0; line-height: 1.68; }
  .why-item-before p { color: var(--color-text-secondary); }
  .why-item-after  p { color: var(--color-text); font-weight: 500; }

  /* Divider central */
  .why-divider {
    display: flex; flex-direction: column; align-items: center;
    padding-top: 2.5rem;
  }
  .why-divider-line {
    flex: 1; width: 1px; min-height: 24px;
    background: linear-gradient(to bottom, transparent, var(--color-border) 20%, var(--color-border) 80%, transparent);
    transform: scaleY(0); transform-origin: top;
    transition: transform 0.9s cubic-bezier(0.22,1,0.36,1) 0.15s;
  }
  .why-divider-line.is-visible { transform: scaleY(1); }
  .why-divider-arrow {
    font-size: 0.78rem; color: var(--color-text-secondary); opacity: 0.3;
    padding: 8px 0; line-height: 1;
    animation: why-pulse 2.4s ease-in-out infinite;
  }
  @keyframes why-pulse {
    0%, 100% { opacity: 0.3; transform: translateX(0); }
    50%       { opacity: 0.7; transform: translateX(3px); }
  }

  /* Stat footer */
  .why-footer {
    background: #091440;
    border-radius: 16px;
    padding: 1.75rem 2.25rem;
    display: flex; align-items: center; justify-content: space-between;
    gap: 1.5rem; flex-wrap: wrap;
    opacity: 0; transform: translateY(28px);
    transition: opacity 0.65s ease 0.15s, transform 0.7s cubic-bezier(0.22,1,0.36,1) 0.15s;
    position: relative; overflow: hidden;
  }
  .why-footer::before {
    content: '';
    position: absolute; inset: 0;
    background: radial-gradient(ellipse 60% 80% at 10% 50%, rgba(164,37,147,0.18) 0%, transparent 70%);
    pointer-events: none;
  }
  .why-footer.is-visible { opacity: 1; transform: translateY(0); }

  .why-footer-stat { display: flex; align-items: center; gap: 1.25rem; flex-wrap: wrap; position: relative; }
  .why-stat-num {
    font-size: 3rem; font-weight: 800; color: #fff;
    line-height: 1; letter-spacing: -0.04em; font-variant-numeric: tabular-nums;
  }
  .why-stat-text { font-size: 0.85rem; color: rgba(255,255,255,0.48); line-height: 1.6; max-width: 230px; }

  .why-footer-cta {
    display: inline-flex; align-items: center; gap: 0.45rem;
    background: #fff; color: #091440;
    font-weight: 700; font-size: 0.9rem;
    padding: 0.7rem 1.5rem; border-radius: 50px;
    text-decoration: none; white-space: nowrap; flex-shrink: 0; position: relative;
    transition: transform 0.22s ease, box-shadow 0.22s ease;
    box-shadow: 0 4px 18px rgba(0,0,0,0.2);
  }
  .why-footer-cta:hover { transform: translateY(-3px); box-shadow: 0 10px 28px rgba(0,0,0,0.28); }
  .why-footer-cta::after {
    content: '→';
    transition: transform 0.22s ease;
  }
  .why-footer-cta:hover::after { transform: translateX(4px); }

  /* ── Responsive tablet (601–1024px) ── */
  @media (max-width: 1024px) and (min-width: 601px) {
    .why-split { grid-template-columns: 1fr 36px 1fr; }
    .why-footer { padding: 1.5rem 1.75rem; }
    .why-stat-num { font-size: 2.5rem; }
  }

  /* ── Responsive mobile (≤600px) ── */
  @media (max-width: 600px) {
    .why-intro { font-size: 0.97rem; margin-bottom: 2rem; }
    .why-split { grid-template-columns: 1fr; gap: 0; }
    .why-divider { display: none; }

    .why-col-before { padding-bottom: 1.75rem; border-bottom: 1px solid var(--color-border); }
    .why-col-after  { padding-top: 1.75rem; }

    .why-item-before,
    .why-item-after { transform: translateY(20px); }
    .why-item.is-visible { transform: translateY(0); }

    .why-item { padding: 0.5rem 0.75rem; border-radius: 0 6px 6px 0; }
    .why-item p { font-size: 0.92rem; }

    .why-footer {
      padding: 1.25rem 1.25rem;
      border-radius: 12px;
      flex-direction: column;
      align-items: flex-start;
      gap: 1.1rem;
    }
    .why-stat-num { font-size: 2.25rem; }
    .why-stat-text { max-width: 100%; }
    .why-footer-cta { width: 100%; justify-content: center; }
  }

  @media (prefers-reduced-motion: reduce) {
    .why-item, .why-col-label, .why-footer { transition: none; animation: none; }
    .why-divider-line { transition: none; }
    .why-divider-arrow { animation: none; }
  }

  .home-services { overflow: hidden; }
  .home-services-circle-1 { top: 10%; right: -70px; width: 220px; height: 220px; }
  .home-services-circle-2 { bottom: -60px; left: 4%; width: 160px; height: 160px; }
  .home-services-inner { position: relative; z-index: 1; display: grid; grid-template-columns: 1fr 240px; gap: 2rem; align-items: center; }
  .home-services-text { min-width: 0; }
  .home-services-list { list-style: none; display: flex; flex-direction: column; gap: 1.5rem; margin: 2rem 0; max-width: 720px; }
  .home-services-list li { display: flex; gap: 1.25rem; align-items: baseline; border-bottom: 1px solid var(--color-border); padding-bottom: 1.25rem; }
  .home-services-list .num { font-size: 1.5rem; color: var(--color-accent); flex-shrink: 0; }
  .home-services-list h3 { margin-bottom: 0.25rem; }
  .home-services-list p { font-size: 0.92rem; margin: 0; }

  .link-arrow { font-weight: 600; color: var(--color-accent); display: inline-block; margin-top: 1rem; }
  .link-arrow:hover { text-decoration: underline; }

  .moodle-badges { margin-top: 2rem; }
  .badges-label { font-size: 0.8rem; font-weight: 600; text-transform: uppercase; letter-spacing: 0.06em; color: var(--color-text-secondary); margin-bottom: 0.75rem; }
  .badges-row { display: flex; gap: 1.25rem; align-items: flex-start; }
  .badge-item { display: flex; flex-direction: column; align-items: center; gap: 0.4rem; text-align: center; }
  .badge-item img { width: 72px; height: 72px; object-fit: contain; transition: transform 0.25s ease; }
  .badge-item img:hover { transform: scale(1.08); }
  .badge-item span { font-size: 0.72rem; color: var(--color-text-secondary); line-height: 1.3; }

  .tools-orbit { position: relative; width: 220px; height: 220px; margin: 0 auto; }
  .orbit-hub { position: absolute; top: 50%; left: 50%; width: 54px; height: 54px; margin: -27px 0 0 -27px; border-radius: 50%; background: linear-gradient(135deg, var(--color-primary), var(--color-accent)); box-shadow: 0 14px 28px -10px rgba(2, 33, 121, 0.4); }
  .orbit-ring { position: absolute; top: 50%; left: 50%; border-radius: 50%; border: 1px dashed var(--color-border); }
  .orbit-ring-1 { width: 200px; height: 200px; margin: -100px 0 0 -100px; animation: orbit-spin 18s linear infinite; }
  .orbit-ring-2 { width: 200px; height: 200px; margin: -100px 0 0 -100px; animation: orbit-spin 18s linear infinite; animation-delay: -9s; }
  .orbit-ring-3 { width: 158px; height: 158px; margin: -79px 0 0 -79px; animation: orbit-spin 24s linear infinite reverse; }
  .orbit-ring-4 { width: 158px; height: 158px; margin: -79px 0 0 -79px; animation: orbit-spin 24s linear infinite reverse; animation-delay: -12s; }
  .orbit-ring-5 { width: 112px; height: 112px; margin: -56px 0 0 -56px; animation: orbit-spin 14s linear infinite; }

  .orbit-icon { position: absolute; top: 0; left: 50%; width: 34px; height: 34px; margin-left: -17px; margin-top: -17px; border-radius: 50%; background: var(--color-card-bg); display: flex; align-items: center; justify-content: center; color: var(--color-accent); box-shadow: 0 8px 18px -6px rgba(2, 33, 121, 0.3); }
  .orbit-icon-counter-1 { animation: orbit-spin 18s linear infinite reverse; }
  .orbit-icon-counter-2 { animation: orbit-spin 18s linear infinite reverse; animation-delay: -9s; }
  .orbit-icon-counter-3 { animation: orbit-spin 24s linear infinite; }
  .orbit-icon-counter-4 { animation: orbit-spin 24s linear infinite; animation-delay: -12s; }
  .orbit-icon-counter-5 { animation: orbit-spin 14s linear infinite reverse; color: var(--color-primary); }

  @keyframes orbit-spin {
    from { transform: rotate(0deg); }
    to { transform: rotate(360deg); }
  }

  .home-cta { position: relative; overflow: hidden; padding: 5.5rem 0; color: #fff; }
  .home-cta-img {
    position: absolute; inset: 0;
    background-image: url('/images/hero/Testimony%201.webp');
    background-size: cover; background-position: center; z-index: 0;
  }
  .home-cta-overlay {
    position: absolute; inset: 0;
    background: linear-gradient(110deg, rgba(2,33,121,0.95) 0%, rgba(2,33,121,0.80) 60%, rgba(164,37,147,0.50) 100%);
    z-index: 1;
  }
  .home-cta-inner { position: relative; z-index: 2; max-width: 580px; margin-left: 4rem; text-align: left; }
  .home-cta-eyebrow { font-size: 0.75rem; font-weight: 700; letter-spacing: 0.12em; text-transform: uppercase; color: rgba(255,255,255,0.6); margin-bottom: 1rem; }
  .home-cta-title { font-size: clamp(1.7rem, 4vw, 2.5rem); font-weight: 800; line-height: 1.15; letter-spacing: -0.02em; color: #fff; margin-bottom: 1rem; }
  .home-cta-sub { font-size: 1rem; line-height: 1.75; color: rgba(255,255,255,0.78); margin-bottom: 2.25rem; }
  .btn-hero {
    display: inline-flex; align-items: center; gap: 0.5rem;
    padding: 0.9rem 1.75rem; border-radius: 50px;
    background: #fff; color: var(--color-primary);
    font-weight: 700; font-size: 0.95rem; text-decoration: none;
    box-shadow: 0 8px 28px rgba(0,0,0,0.22);
    transition: transform 0.22s ease, box-shadow 0.22s ease; white-space: nowrap;
  }
  .btn-hero:hover { transform: translateY(-3px); box-shadow: 0 14px 36px rgba(0,0,0,0.28); }
  .btn-hero svg { transition: transform 0.22s ease; }
  .btn-hero:hover svg { transform: translateX(4px); }

  @media (max-width: 640px) {
    .home-cta { padding: 3.5rem 0; }
    .home-cta-inner { margin-left: 0; max-width: 100%; }
    .home-cta-title { font-size: clamp(1.5rem, 7vw, 2rem); }
  }

  @media (max-width: 900px) {
    .home-services-inner { grid-template-columns: 1fr; }
    .tools-orbit { margin-top: 1rem; }
  }

  @media (max-width: 640px) {
    .home-services-list { gap: 1rem; }
  }
</style>

<script is:inline>
(function () {
  var isMobile     = window.matchMedia('(max-width: 600px)').matches;
  var beforeItems  = document.querySelectorAll('.why-item-before');
  var afterItems   = document.querySelectorAll('.why-item-after');
  var labels       = document.querySelectorAll('.why-col-label');
  var divLines     = document.querySelectorAll('.why-divider-line');
  var footer       = document.querySelector('.why-footer');
  var statNum      = document.querySelector('.why-stat-num');

  function stagger(els, baseDelay, step, cls) {
    els.forEach(function (el, i) {
      setTimeout(function () { el.classList.add(cls || 'is-visible'); }, baseDelay + i * step);
    });
  }

  var splitEl = document.querySelector('.why-split');
  if (splitEl) {
    new IntersectionObserver(function (entries) {
      if (!entries[0].isIntersecting) return;
      stagger(labels, 0, 80);
      if (!isMobile) {
        setTimeout(function () {
          divLines.forEach(function (l) { l.classList.add('is-visible'); });
        }, 80);
      }
      stagger(beforeItems, isMobile ? 120 : 100, 120);
      stagger(afterItems, isMobile ? 560 : 180, 120);
      this.disconnect();
    }, { threshold: 0.12 }).observe(splitEl);
  }

  if (footer) {
    new IntersectionObserver(function (entries) {
      if (!entries[0].isIntersecting) return;
      footer.classList.add('is-visible');
      if (statNum) {
        var t0 = performance.now();
        var dur = window.matchMedia('(prefers-reduced-motion: reduce)').matches ? 0 : 1400;
        statNum.textContent = '0%';
        (function tick(now) {
          var p = Math.min((now - t0) / dur, 1);
          var eased = dur === 0 ? 1 : 1 - Math.pow(1 - p, 3);
          statNum.textContent = Math.round(eased * 100) + '%';
          if (p < 1) requestAnimationFrame(tick);
        })(t0);
      }
      this.disconnect();
    }, { threshold: 0.35 }).observe(footer);
  }
})();
</script>
