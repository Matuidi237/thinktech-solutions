---
import BaseLayout from "../../layouts/BaseLayout.astro";
import Header from "../../components/layout/Header.astro";
import Footer from "../../components/layout/Footer.astro";
import Hero from "../../components/sections/Hero.astro";
import ChatbotWidget from "../../components/chatbot/ChatbotWidget.astro";
import { useTranslations } from "../../i18n/utils";

const lang = "fr";
const t = useTranslations(lang);
---

<BaseLayout
  lang={lang}
  title="ThinkTech Solutions Plateformes Moodle pour la formation en Afrique"
  description="Expert Moodle Cameroun. ThinkTech Solutions conçoit et déploie des plateformes e-learning sécurisées pour universités, entreprises et ONG à Douala et en Afrique centrale."
>
  <Header lang={lang} />
  <main id="main-content">
    <Hero lang={lang} />

    <section class="home-why" aria-labelledby="home-why-title">
      <div class="why-grid">

        <div class="why-image-wrap reveal-left">
          <img
            src="/images/about/mission.webp"
            alt="Apprenant en formation en ligne"
            class="why-image"
            loading="lazy"
            width="800" height="600"
          />
        </div>

        <div class="why-content">
          <p class="why-eyebrow reveal" style="--rv:0">
            <span class="eyebrow-dot" aria-hidden="true"></span>
            Pourquoi maintenant
          </p>

          <h2 id="home-why-title" class="reveal" style="--rv:1">
            La formation en présentiel coûte cher.<br/>Et ça se voit.
          </h2>

          <p class="why-lead reveal" style="--rv:2">Un enseignant qui jongle entre trois établissements. Des polycopiés à la hâte. Une promo de 80 étudiants pour un seul formateur. Ce n'est pas un manque de volonté — c'est un système qui a atteint ses limites.</p>

          <div class="why-block reveal" style="--rv:3">
            <h3 class="why-block-title">L'absentéisme bloque tout</h3>
            <p>Quand un formateur ne peut pas venir, la session tombe. Sur Moodle, le cours est disponible 24h/24, qu'il soit là ou non.</p>
          </div>

          <div class="why-block reveal" style="--rv:4">
            <h3 class="why-block-title">Le transport, c'est du temps perdu</h3>
            <p>À Douala ou Yaoundé, un étudiant peut passer deux heures dans les embouteillages pour une heure de cours. L'accès en ligne supprime cette équation.</p>
          </div>

          <div class="why-block reveal" style="--rv:5">
            <h3 class="why-block-title">Les supports ne survivent pas au semestre</h3>
            <p>Photocopies froissées, polys introuvables l'année suivante. Une plateforme centralise tout, pour tous, pour toujours.</p>
          </div>

          <div class="why-block reveal" style="--rv:6">
            <h3 class="why-block-title">Les promos grossissent, les salles non</h3>
            <p>Chaque nouvelle promotion mobilise les mêmes locaux, les mêmes frais. Le digital casse ce plafond sans changer d'infrastructure.</p>
          </div>

          <a href={`/${lang}/contact`} class="why-cta reveal" style="--rv:7">
            Parlons de votre projet <span aria-hidden="true">→</span>
          </a>
        </div>

      </div>
    </section>

    <section class="home-services" aria-labelledby="home-services-title">
      <div class="circle-deco home-services-circle-1" aria-hidden="true"></div>
      <div class="circle-deco circle-fill circle-delay home-services-circle-2" aria-hidden="true"></div>
      <div class="container home-services-inner">
        <div class="home-services-text">
          <p class="eyebrow">Notre expertise</p>
          <h2 id="home-services-title">{t.services.title}</h2>
          <ol class="home-services-list">
            {t.services.cards.map((c: any, i: number) => (
              <li>
                <span class="num">{String(i + 1).padStart(2, "0")}</span>
                <div>
                  <h3>{c.title}</h3>
                  <p>{c.benefit}</p>
                </div>
              </li>
            ))}
          </ol>
          <a href={`/${lang}/services`} class="link-arrow">Voir le détail de nos services →</a>
        </div>
        <div class="tools-orbit" aria-hidden="true">
          <span class="orbit-hub"></span>
          <div class="orbit-ring orbit-ring-1">
            <span class="orbit-icon orbit-icon-counter-1">
              <svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M14.7 6.3a1 1 0 0 0 0 1.4l1.6 1.6a1 1 0 0 0 1.4 0l3.77-3.77a6 6 0 0 1-7.94 7.94l-6.91 6.91a2.12 2.12 0 0 1-3-3l6.91-6.91a6 6 0 0 1 7.94-7.94l-3.76 3.76z"/></svg>
            </span>
          </div>
          <div class="orbit-ring orbit-ring-2">
            <span class="orbit-icon orbit-icon-counter-2">
              <svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="2" y="2" width="20" height="8" rx="2"/><rect x="2" y="14" width="20" height="8" rx="2"/><path d="M6 6h.01M6 18h.01"/></svg>
            </span>
          </div>
          <div class="orbit-ring orbit-ring-3">
            <span class="orbit-icon orbit-icon-counter-3">
              <svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"/></svg>
            </span>
          </div>
          <div class="orbit-ring orbit-ring-4">
            <span class="orbit-icon orbit-icon-counter-4">
              <svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M22 10 12 5 2 10l10 5 10-5z"/><path d="M6 12v5c0 1.5 3 3 6 3s6-1.5 6-3v-5"/></svg>
            </span>
          </div>
          <div class="orbit-ring orbit-ring-5">
            <span class="orbit-icon orbit-icon-counter-5">
              <svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M9 2v6M15 2v6M5 8h14l-1 5a6 6 0 0 1-12 0L5 8z"/><path d="M12 19v3"/></svg>
            </span>
          </div>
        </div>
      </div>
    </section>

    <section class="home-cta" aria-labelledby="home-cta-title">
      <div class="home-cta-img" aria-hidden="true"></div>
      <div class="home-cta-overlay" aria-hidden="true"></div>
      <div class="container">
        <div class="home-cta-inner reveal">
          <p class="home-cta-eyebrow">{t.contact.eyebrow ?? "Travaillons ensemble"}</p>
          <h2 id="home-cta-title" class="home-cta-title">{t.contact.title}</h2>
          <p class="home-cta-sub">{t.contact.subtitle}</p>
          <a href={`/${lang}/contact`} class="btn-hero">
            {t.hero.ctaPrimary}
            <svg viewBox="0 0 20 20" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" width="18" height="18"><path d="M4 10h12M11 5l5 5-5 5"/></svg>
          </a>
        </div>
      </div>
    </section>
  </main>
  <Footer lang={lang} />
  <ChatbotWidget lang={lang} />
</BaseLayout>

<style>
  /* ── Section Pourquoi digitaliser ── */
  .home-why {
    background: var(--color-bg-secondary);
    padding: 5rem 0;
    overflow: hidden;
  }

  /* Grid identique à mv-grid sur About */
  .why-grid {
    display: grid;
    grid-template-columns: 1fr 1fr;
    align-items: center;
  }

  /* Image gauche — saigne jusqu'au bord, arrondi côté droit */
  .why-image-wrap {
    position: relative;
    height: 560px;
    overflow: hidden;
    opacity: 0;
    transform: translateX(-48px);
    transition: opacity 0.8s ease, transform 0.9s cubic-bezier(0.22, 1, 0.36, 1);
  }
  .why-image-wrap.is-visible { opacity: 1; transform: translateX(0); }
  .why-image {
    width: 100%; height: 100%;
    object-fit: cover; object-position: center top;
    display: block;
    border-radius: 0 16px 16px 0;
    transition: transform 0.7s cubic-bezier(0.22, 1, 0.36, 1);
  }
  .why-image-wrap:hover .why-image { transform: scale(1.03); }

  /* Texte droite — padding calqué sur mv-content */
  .why-content {
    padding: 2rem max(2rem, calc((100vw - 1200px) / 2 + 2rem)) 2rem 4rem;
  }

  /* Eyebrow */
  .why-eyebrow {
    display: flex; align-items: center; gap: 0.5rem;
    font-size: 0.72rem; font-weight: 700;
    letter-spacing: 0.13em; text-transform: uppercase;
    color: var(--color-primary);
    margin-bottom: 1.25rem;
  }
  .eyebrow-dot {
    width: 8px; height: 8px; border-radius: 50%;
    background: var(--color-accent); flex-shrink: 0;
  }

  /* Titre principal */
  .why-content h2 {
    font-size: clamp(1.5rem, 2.6vw, 2rem);
    font-weight: 800; line-height: 1.18;
    letter-spacing: -0.02em;
    margin-bottom: 1rem;
  }

  /* Intro */
  .why-lead {
    font-size: 0.97rem; line-height: 1.8;
    color: var(--color-text-secondary);
    margin-bottom: 2rem;
  }

  /* Blocs raisons — calqués sur mv-block */
  .why-block { margin-bottom: 1.5rem; }
  .why-block-title {
    font-size: 1rem; font-weight: 700;
    color: var(--color-primary);
    margin-bottom: 0.4rem;
    padding-left: 0.75rem;
    border-left: 3px solid var(--color-accent);
  }
  .why-block p {
    font-size: 0.93rem; line-height: 1.78;
    color: var(--color-text-secondary);
    margin: 0;
  }

  /* CTA — calqué sur mv-cta */
  .why-cta {
    display: inline-flex; align-items: center; gap: 0.5rem;
    font-size: 0.9rem; font-weight: 700;
    color: var(--color-primary);
    border-bottom: 2px solid transparent;
    padding-bottom: 2px; margin-top: 0.5rem;
    text-decoration: none;
    transition: border-color 0.2s ease, gap 0.2s ease;
  }
  .why-cta:hover { border-color: var(--color-accent); gap: 0.75rem; }

  /* Reveal stagger */
  .why-content .reveal {
    opacity: 0; transform: translateY(20px);
    transition: opacity 0.55s ease calc(var(--rv, 0) * 0.08s),
                transform 0.55s ease calc(var(--rv, 0) * 0.08s);
  }
  .why-content .reveal.is-visible { opacity: 1; transform: none; }

  /* ── Tablette (601–1024px) ── */
  @media (max-width: 1024px) and (min-width: 601px) {
    .why-grid { grid-template-columns: 1fr 1fr; }
    .why-image-wrap { height: 420px; }
    .why-content { padding: 2rem 2rem 2rem 2.5rem; }
  }

  /* ── Mobile (≤600px) ── */
  @media (max-width: 600px) {
    .home-why { padding: 3rem 0 3.5rem; }
    .why-grid { grid-template-columns: 1fr; }
    .why-image-wrap { height: 260px; border-radius: 0; }
    .why-image { border-radius: 0; }
    .why-content { padding: 2rem 1.25rem; }
    .why-block { margin-bottom: 1.25rem; }
    .why-block p { font-size: 0.92rem; }
  }

  @media (prefers-reduced-motion: reduce) {
    .why-image-wrap, .why-content .reveal { transition: none; }
    .why-image { transition: none; }
  }

  .home-services { overflow: hidden; }
  .home-services-circle-1 { top: 10%; right: -70px; width: 220px; height: 220px; }
  .home-services-circle-2 { bottom: -60px; left: 4%; width: 160px; height: 160px; }
  .home-services-inner { position: relative; z-index: 1; display: grid; grid-template-columns: 1fr 240px; gap: 2rem; align-items: center; }
  .home-services-text { min-width: 0; }
  .home-services-list { list-style: none; display: flex; flex-direction: column; gap: 1.5rem; margin: 2rem 0; max-width: 720px; }
  .home-services-list li { display: flex; gap: 1.25rem; align-items: baseline; border-bottom: 1px solid var(--color-border); padding-bottom: 1.25rem; }
  .home-services-list .num { font-size: 1.5rem; color: var(--color-accent); flex-shrink: 0; }
  .home-services-list h3 { margin-bottom: 0.25rem; }
  .home-services-list p { font-size: 0.92rem; margin: 0; }

  .link-arrow { font-weight: 600; color: var(--color-accent); display: inline-block; margin-top: 1rem; }
  .link-arrow:hover { text-decoration: underline; }

  .moodle-badges { margin-top: 2rem; }
  .badges-label { font-size: 0.8rem; font-weight: 600; text-transform: uppercase; letter-spacing: 0.06em; color: var(--color-text-secondary); margin-bottom: 0.75rem; }
  .badges-row { display: flex; gap: 1.25rem; align-items: flex-start; }
  .badge-item { display: flex; flex-direction: column; align-items: center; gap: 0.4rem; text-align: center; }
  .badge-item img { width: 72px; height: 72px; object-fit: contain; transition: transform 0.25s ease; }
  .badge-item img:hover { transform: scale(1.08); }
  .badge-item span { font-size: 0.72rem; color: var(--color-text-secondary); line-height: 1.3; }

  .tools-orbit { position: relative; width: 220px; height: 220px; margin: 0 auto; }
  .orbit-hub { position: absolute; top: 50%; left: 50%; width: 54px; height: 54px; margin: -27px 0 0 -27px; border-radius: 50%; background: linear-gradient(135deg, var(--color-primary), var(--color-accent)); box-shadow: 0 14px 28px -10px rgba(2, 33, 121, 0.4); }
  .orbit-ring { position: absolute; top: 50%; left: 50%; border-radius: 50%; border: 1px dashed var(--color-border); }
  .orbit-ring-1 { width: 200px; height: 200px; margin: -100px 0 0 -100px; animation: orbit-spin 18s linear infinite; }
  .orbit-ring-2 { width: 200px; height: 200px; margin: -100px 0 0 -100px; animation: orbit-spin 18s linear infinite; animation-delay: -9s; }
  .orbit-ring-3 { width: 158px; height: 158px; margin: -79px 0 0 -79px; animation: orbit-spin 24s linear infinite reverse; }
  .orbit-ring-4 { width: 158px; height: 158px; margin: -79px 0 0 -79px; animation: orbit-spin 24s linear infinite reverse; animation-delay: -12s; }
  .orbit-ring-5 { width: 112px; height: 112px; margin: -56px 0 0 -56px; animation: orbit-spin 14s linear infinite; }

  .orbit-icon { position: absolute; top: 0; left: 50%; width: 34px; height: 34px; margin-left: -17px; margin-top: -17px; border-radius: 50%; background: var(--color-card-bg); display: flex; align-items: center; justify-content: center; color: var(--color-accent); box-shadow: 0 8px 18px -6px rgba(2, 33, 121, 0.3); }
  .orbit-icon-counter-1 { animation: orbit-spin 18s linear infinite reverse; }
  .orbit-icon-counter-2 { animation: orbit-spin 18s linear infinite reverse; animation-delay: -9s; }
  .orbit-icon-counter-3 { animation: orbit-spin 24s linear infinite; }
  .orbit-icon-counter-4 { animation: orbit-spin 24s linear infinite; animation-delay: -12s; }
  .orbit-icon-counter-5 { animation: orbit-spin 14s linear infinite reverse; color: var(--color-primary); }

  @keyframes orbit-spin {
    from { transform: rotate(0deg); }
    to { transform: rotate(360deg); }
  }

  .home-cta { position: relative; overflow: hidden; padding: 5.5rem 0; color: #fff; }
  .home-cta-img {
    position: absolute; inset: 0;
    background-image: url('/images/hero/Testimony%201.webp');
    background-size: cover; background-position: center; z-index: 0;
  }
  .home-cta-overlay {
    position: absolute; inset: 0;
    background: linear-gradient(110deg, rgba(2,33,121,0.95) 0%, rgba(2,33,121,0.80) 60%, rgba(164,37,147,0.50) 100%);
    z-index: 1;
  }
  .home-cta-inner { position: relative; z-index: 2; max-width: 580px; margin-left: 4rem; text-align: left; }
  .home-cta-eyebrow { font-size: 0.75rem; font-weight: 700; letter-spacing: 0.12em; text-transform: uppercase; color: rgba(255,255,255,0.6); margin-bottom: 1rem; }
  .home-cta-title { font-size: clamp(1.7rem, 4vw, 2.5rem); font-weight: 800; line-height: 1.15; letter-spacing: -0.02em; color: #fff; margin-bottom: 1rem; }
  .home-cta-sub { font-size: 1rem; line-height: 1.75; color: rgba(255,255,255,0.78); margin-bottom: 2.25rem; }
  .btn-hero {
    display: inline-flex; align-items: center; gap: 0.5rem;
    padding: 0.9rem 1.75rem; border-radius: 50px;
    background: #fff; color: var(--color-primary);
    font-weight: 700; font-size: 0.95rem; text-decoration: none;
    box-shadow: 0 8px 28px rgba(0,0,0,0.22);
    transition: transform 0.22s ease, box-shadow 0.22s ease; white-space: nowrap;
  }
  .btn-hero:hover { transform: translateY(-3px); box-shadow: 0 14px 36px rgba(0,0,0,0.28); }
  .btn-hero svg { transition: transform 0.22s ease; }
  .btn-hero:hover svg { transform: translateX(4px); }

  @media (max-width: 640px) {
    .home-cta { padding: 3.5rem 0; }
    .home-cta-inner { margin-left: 0; max-width: 100%; }
    .home-cta-title { font-size: clamp(1.5rem, 7vw, 2rem); }
  }

  @media (max-width: 900px) {
    .home-services-inner { grid-template-columns: 1fr; }
    .tools-orbit { margin-top: 1rem; }
  }

  @media (max-width: 640px) {
    .home-services-list { gap: 1rem; }
    .home-services-list li { gap: 0.75rem; }
  }
</style>

<script is:inline>
(function () {
  var imageWrap = document.querySelector('.why-image-wrap');
  var reveals   = document.querySelectorAll('.why-content .reveal');
  if (!imageWrap && !reveals.length) return;

  var io = new IntersectionObserver(function (entries) {
    entries.forEach(function (e) {
      if (e.isIntersecting) {
        e.target.classList.add('is-visible');
        io.unobserve(e.target);
      }
    });
  }, { threshold: 0.15 });

  if (imageWrap) io.observe(imageWrap);
  reveals.forEach(function (el) { io.observe(el); });
})();
</script>
